erDiagram
    User {
        ObjectId _id PK
        string username
        string role "admin, user, ?"
        string email
        boolean isActive
        datetime createdAt
        datetime updatedAt
    }

    Organization { 
        ObjectId _id PK
        string name
        ObjectId createdBy FK
        datetime createdAt
        datetime updatedAt
    }

    Member {
        ObjectId _id PK
        ObjectId user FK
        string username
        string[] roles
        ObjectId organization FK
        datetime createdAt
        datetime updatedAt
    }

    Invite {
        ObjectId _id PK
        string inviteCode "6 digit code"
        string password
        ObjectId organization FK
        string organizationName
        ObjectId createdBy FK
        string status "pending, accepted, revoked"
        datetime createdAt
        datetime updatedAt
    }

    Repair {
        ObjectId _id PK
        string title
        string status "pending, in-progress, completed"
        string type "repair, maintenance, inspection could be FK to a predefined types"
        string category "user defined categories"
        string manufacturer "user defined manufacturers"
        string model "user defined models"
        string visibility "public, private"
        ObjectId createdBy FK
        boolean removed "default: false"
        Procedure[] procedures
        datetime createdAt
        datetime updatedAt
    }

    RepairHistory {
        ObjectId _id PK
        ObjectId repair FK
        Object data "snapshot of repair data as its updated"
        datetime createdAt
    }

    UserAuthAccount {
        ObjectId _id PK
        ObjectId userId FK
        string provider "google, facebook, etc."
        string providerUserId "user ID from the provider"
        string email
        boolean emailVerified
        datetime createdAt
        datetime updatedAt
    }

    Procedure {
        ObjectId _id PK
        Image[] images
        string instructions
    }

    Image {
        ObjectId _id PK
        string url
        string caption
        string folder "folder name or path in storage could be bucket name"
        string imageId "unique identifier for the image"
        string thumbnail
    }

    %% Relationships
    User ||--o{ Organization : "creates"
    User ||--o{ Member : "belongs to"
    Organization ||--o{ Member : "has"
    User ||--o{ Invite : "creates"
    Organization ||--o{ Invite : "for"
    User ||--o{ Repair : "creates"
    Repair ||--o{ RepairHistory : "has history"
    Repair ||--o{ Comment : "has comments"
    Comment ||--o{ Comment : "replies to"
    User ||--o{ UserAuthAccount : "has auth"
    Repair ||--o{ Procedure : "contains"
    Procedure ||--o{ Image : "contains"

