style User fill:#90ee90,stroke:#000,stroke-width:2px,color:#000
style Organization fill:#87cefa,stroke:#000,stroke-width:2px,color:#000
style Member fill:#ffd580,stroke:#000,stroke-width:2px,color:#000
style Invite fill:#ffb6b6,stroke:#000,stroke-width:2px,color:#000
style Repair fill:#dab6ff,stroke:#000,stroke-width:2px,color:#000
style RepairHistory fill:#ffb6ff,stroke:#000,stroke-width:2px,color:#000
style Comment fill:#b0c4de,stroke:#000,stroke-width:2px,color:#000
style UserAuthAccount fill:#a0ffff,stroke:#000,stroke-width:2px,color:#000
style Procedure fill:#ffe4b5,stroke:#000,stroke-width:2px,color:#000
style Image fill:#b0aaff,stroke:#000,stroke-width:2px,color:#000